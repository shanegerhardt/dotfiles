#!/bin/bash
# ssh-keygen wrapper used by git as gpg.ssh.program (see install.sh gitlocal).
#
# When commit signing needs a touch on the YubiKey, `ssh-keygen -Y sign` just
# prints "Confirm user presence for key ..." to stderr (it does not use
# SSH_ASKPASS, unlike ssh itself). So we watch stderr for that line and, when
# it appears, post a macOS notification naming the commit/tag being signed
# (via terminal-notifier, from the Brewfile) and play a sound. Without
# terminal-notifier it falls back to the sound alone. stderr, stdout and the
# exit status of ssh-keygen are preserved.
set -u
SOUND="${SSH_TOUCH_SOUND:-Morse}"   # a name from /System/Library/Sounds

for k in "${SSH_KEYGEN_REAL:-}" \
         /opt/homebrew/opt/openssh/bin/ssh-keygen \
         /usr/local/opt/openssh/bin/ssh-keygen; do
  [[ -n "$k" && -x "$k" ]] && { real="$k"; break; }
done
real="${real:-$(command -v ssh-keygen)}"

# git invokes us as `-Y sign -n git -f <key> <bufferfile>`; the buffer is the
# raw commit/tag object: headers, blank line, message. Title = first message line.
describe_object() {
  local buf="${*: -1}" kind title
  [[ -f "$buf" ]] || { echo "git signing"; return; }
  kind=$(awk 'NR==1{print $1; exit}' "$buf")
  title=$(awk 'blank{print; exit} /^$/{blank=1}' "$buf")
  case "$kind" in
    tree)   echo "Commit: ${title:-<no message>}" ;;
    object) echo "Tag: ${title:-<no message>}" ;;
    *)      echo "git signing" ;;
  esac
}

notify() {
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "Touch your YubiKey" -message "$1" \
      -sound "$SOUND" -group git-ssh-sign >/dev/null 2>&1 &
  else
    afplay "/System/Library/Sounds/$SOUND.aiff" >/dev/null 2>&1 &
  fi
}

what="$(describe_object "$@")"

# fd 3 carries ssh-keygen's real stdout past the pipe; only stderr is filtered.
{
  "$real" "$@" 2>&1 1>&3 | while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line" >&2
    case "$line" in
      *"Confirm user presence"*) notify "$what" ;;
    esac
  done
  exit "${PIPESTATUS[0]}"
} 3>&1
