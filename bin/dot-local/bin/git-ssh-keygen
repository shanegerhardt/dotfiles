#!/bin/bash
# ssh-keygen wrapper used by git as gpg.ssh.program (see install.sh gitlocal).
#
# When commit signing needs a touch on the YubiKey, `ssh-keygen -Y sign` just
# prints "Confirm user presence for key ..." to stderr (it does not use
# SSH_ASKPASS, unlike ssh itself). So we watch stderr for that line and play a
# system sound when it appears, then pass the line through unchanged. Exit
# status and stdout of ssh-keygen are preserved.
set -u
SOUND="${SSH_TOUCH_SOUND:-/System/Library/Sounds/Morse.aiff}"

for k in "${SSH_KEYGEN_REAL:-}" \
         /opt/homebrew/opt/openssh/bin/ssh-keygen \
         /usr/local/opt/openssh/bin/ssh-keygen; do
  [[ -n "$k" && -x "$k" ]] && { real="$k"; break; }
done
real="${real:-$(command -v ssh-keygen)}"

# fd 3 carries ssh-keygen's real stdout past the pipe; only stderr is filtered.
{
  "$real" "$@" 2>&1 1>&3 | while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line" >&2
    case "$line" in
      *"Confirm user presence"*) afplay "$SOUND" >/dev/null 2>&1 & ;;
    esac
  done
  exit "${PIPESTATUS[0]}"
} 3>&1
