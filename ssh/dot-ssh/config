Host github.com
  IdentityFile ~/.ssh/id_ed25519_sk_rk_github
  IdentitiesOnly yes
  # Reuse one authenticated connection for subsequent git operations so the
  # YubiKey only needs a touch once per ControlPersist window, not on every
  # background fetch. ~/.ssh/sockets is created by install.sh (ensure_ssh_sockets).
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 1h
  ServerAliveInterval 60
